# ============================================================================
# LLM Provider Configuration
# ============================================================================
# Set LLM_PROVIDER to: groq, openai, or gemini
# Only the selected provider's API key and model will be used
LLM_PROVIDER=groq

# Groq Configuration (Fast, cost-effective)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# Other Groq models: llama-3.1-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
# Other OpenAI models: gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo

# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro
# Other Gemini models: gemini-1.5-flash, gemini-1.0-pro

# ============================================================================
# Database Configuration
# ============================================================================

# SQL Server - Inventory
SQL_DB_CONN="DRIVER={ODBC Driver 17 for SQL Server};Server=localhost;DATABASE=InventoryDB;Trusted_Connection=yes;TrustServerCertificate=yes;"

# PostgreSQL - Sales
PG_DB_CONN=dbname=SalesDB user=postgres password=your_password host=localhost port=5432

# MongoDB - Customers
MONGO_URI=mongodb://localhost:27017/
CUSTOMER_DB=CustomerDB
